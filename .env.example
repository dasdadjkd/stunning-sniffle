# Target app. Must resolve to localhost / *.test / *.localhost unless the host
# is explicitly listed in ALLOWED_HOSTS. Production hosts are rejected.
BASE_URL=http://localhost:3000
# Comma-separated extra hosts you own and want to drive, e.g.
# staging.acme.dev — the target guard refuses everything else.
ALLOWED_HOSTS=

# Which adapter this run uses. src/adapters/hoplite.mjs is the Hoplite-shaped
# flow (signup -> emailed code -> onboarding -> plan -> profile).
APP_ADAPTER=src/adapters/hoplite.mjs

# Or describe a deployment in JSON instead of code and select it here. The
# profile overrides routes, selectors and test-card details per run:
#   ADAPTER_PROFILE=profiles/hoplite.json
ADAPTER_PROFILE=

# Parallel workers. Each gets its own browser context (separate cookies,
# storage, cache) inside one browser process.
WORKERS=3

# Which browser to drive.
#   chromium - Playwright's download (needs `npx playwright install chromium`)
#   msedge   - installed Microsoft Edge, no download (Windows default option)
#   chrome   - installed Google Chrome, no download
# Use msedge or chrome when the browser download is blocked or resets.
BROWSER_CHANNEL=chromium
HEADLESS=1

# Verification-code reader. See "Accepting codes" in the README.
OTP_PROVIDER=mailpit

# Mailpit / MailHog HTTP API, used when OTP_PROVIDER=mailpit.
MAILPIT_URL=http://localhost:8025

# IMAP reader, used when OTP_PROVIDER=imap. Run `npm install imapflow
# mailparser`, and use an app password scoped to the staging mailbox only.
IMAP_HOST=
IMAP_PORT=993
IMAP_SECURE=1
IMAP_USER=
IMAP_PASS=
IMAP_MAILBOX=INBOX

# Signup identities. The domain must be a mailbox you control.
EMAIL_DOMAIN=example.test
# Optional fixed password; one is generated per account when empty.
PASSWORD=

# Telegram progress notifications. Both must be set to enable sending.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Credential log. Keep this file private; it is gitignored.
ACCOUNTS_FILE=accounts.txt
DRY_RUN=0
